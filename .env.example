# ─── Required ──────────────────────────────────────────────────────────────
# PostgreSQL connection string (Supabase, Neon, Railway, RDS, local…)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/cardly"
# Public URL of the site, no trailing slash. Used in emails, Stripe redirects, sitemap.
APP_URL="https://www.example.com.au"
# Random secret (32+ chars) used to sign download links and order links.
# Generate with: openssl rand -base64 48
AUTH_SECRET=""

# First admin account (created by `npm run db:seed`). Change the password after first login.
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD=""

# ─── Payments (Stripe) ─────────────────────────────────────────────────────
# Use sk_test_… keys while testing. Without a key, development uses a simulated payment page.
STRIPE_SECRET_KEY=""
# Signing secret of the webhook endpoint https://YOUR-DOMAIN/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=""

# ─── File storage ──────────────────────────────────────────────────────────
# "local" stores files in STORAGE_LOCAL_DIR (fine for a single server / development).
# "s3" works with Supabase Storage (S3 protocol), Cloudflare R2, AWS S3, Backblaze B2…
# Use a PRIVATE bucket: Cardly serves public images itself and never exposes paid files.
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"

# ─── Email (any SMTP provider: Resend, Postmark, Amazon SES, Mailgun…) ─────
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"
EMAIL_FROM="Cardly <hello@example.com.au>"

# ─── Testing only ──────────────────────────────────────────────────────────
# Lets you buy the sample (demo) products — honoured ONLY with Stripe test keys
# or the development simulated payment page. Never set this in production.
ALLOW_DEMO_PURCHASES="false"
